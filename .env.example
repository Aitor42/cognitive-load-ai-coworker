# LoadGuard LLM Provider Configuration
# Choose one of: heuristic | watsonx | ollama (default: heuristic)
LLM_PROVIDER=heuristic

# --- Option A: IBM watsonx.ai (cloud Granite) ---
# WATSONX_API_KEY=your_watsonx_api_key_here
# WATSONX_PROJECT_ID=your_watsonx_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Default model: ibm/granite-3-8b-instruct
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# Default Guardian model: ibm/granite-guardian-3-8b
# WATSONX_GUARDIAN_MODEL_ID=ibm/granite-guardian-3-8b

# --- Option B: Local Ollama (local IBM Granite; no cloud credentials) ---
# OLLAMA_URL=http://localhost:11434
# Default model: granite3.1-dense:8b
# OLLAMA_MODEL=granite3.1-dense:8b
# Default Guardian model: ibm-granite/granite-guardian:3.1-8b
# OLLAMA_GUARDIAN_MODEL=ibm-granite/granite-guardian:3.1-8b

# --- Server Options ---
# HOST=127.0.0.1
# PORT=8000
# LOADGUARD_API_KEY=your_optional_secret_api_key_for_production
# LOADGUARD_ALLOW_DELETE=true   # Set to false to disable DELETE /history and DELETE /audit in production
